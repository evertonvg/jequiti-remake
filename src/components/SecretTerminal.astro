---
---

<div
  class="secret-terminal"
  x-data="{
    active: false,
    output: 'What is the meaning of life?',
    answer: '',
    open() {
      this.active = true;
      this.output = 'What is the meaning of life?';
      this.$nextTick(() => this.$refs.input.focus());
      this.$dispatch('secret-terminal:toggle', { active: true });
    },
    close() {
      this.active = false;
      this.$refs.input.blur();
      this.$dispatch('secret-terminal:toggle', { active: false });
    },
    submit() {
      const value = this.answer.trim();
      if (!value) return;
      this.output += '\n> ' + value;
      this.answer = '';
      if (value.toLowerCase() === 'dvd') {
        this.output += '\nAcesso concedido.';
        new Audio('audio/windowsshutdown.mp3').play().catch((err) => console.error('shutdown audio failed', err));
      }
      this.close();
    },
  }"
  x-on:hypnosis:secret-word.window="open()"
  :class="{ 'secret-terminal--active': active }"
>
  <div class="secret-terminal__window">
    <pre class="secret-terminal__output" x-text="output"></pre>
    <div class="secret-terminal__input-line">
      <span class="secret-terminal__prompt">&gt;</span>
      <input
        class="secret-terminal__input"
        x-ref="input"
        x-model="answer"
        x-on:keydown.stop=""
        x-on:keydown.enter="submit()"
        x-on:keydown.escape="close()"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Terminal input"
      />
    </div>
  </div>
</div>
