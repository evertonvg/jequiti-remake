---
import '../styles/style.css';
import { withBase } from '../lib/base-path';
import SecretTerminal from '../components/SecretTerminal.astro';
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Uma bola hipnótica girando sem parar, escondendo surpresas.">
<meta name="theme-color" content="#000000">

<meta property="og:type" content="website">
<meta property="og:url" content="https://evertonvg.github.io/jequiti-remake/">
<meta property="og:title" content="Hipnose">
<meta property="og:description" content="Uma bola hipnótica girando sem parar, escondendo surpresas.">
<meta property="og:image" content="https://evertonvg.github.io/jequiti-remake/img/ball.png">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Hipnose">
<meta name="twitter:description" content="Uma bola hipnótica girando sem parar, escondendo surpresas.">
<meta name="twitter:image" content="https://evertonvg.github.io/jequiti-remake/img/ball.png">

<title>Hipnose</title>
<link rel="icon" type="image/png" href={withBase('img/favicon.png')}>
</head>
<body>

  <!--
    Easter eggs:
    1) Código Konami (↑ ↑ ↓ ↓ ← → ← → B A) — dispara um vídeo
       surpresa em tela cheia com som: Ronaldinho no modo normal,
       Illuminati no modo vermelho/invertido.
    2) Apertar mais de 20 teclas em menos de 5 segundos — a tela
       escurece aos poucos e, ao ficar totalmente preta, toca o
       vídeo do Skyrim no modo normal, ou o vídeo do Jeff no modo
       vermelho/invertido (pausando a sirene de fundo enquanto o
       vídeo do Jeff toca).
    3) Abrir o DevTools (F12, atalhos, menu do navegador) ou clicar com o
       botão direito — bloqueado via disable-devtool; se detectar o
       DevTools aberto mesmo assim, redireciona para outra página.
    4) Ficar parado sem interagir (mouse, teclado, toque ou scroll)
       por 42 segundos — em qualquer modo — entra em standby com a
       animação (canvas) do logo DVD quicando pelos cantos, trocando
       de cor a cada batida. Some ao apertar qualquer tecla.
    5) Clique duplo — tema angelical: filtro azul, bola parada e
       música angelical.mp3 em loop (substitui o modo vermelho, se
       estiver ativo).
    6) Digitar "jequiti" em qualquer lugar da página — abre um
       terminal secreto perguntando "What is the meaning of life?".
       Resposta certa ("DVD") toca o som de shutdown do Windows;
       qualquer outra resposta não toca nada. O terminal fecha em
       ambos os casos. Acertando, a bola encolhe e passa a poder
       ser arrastada pela tela (continua girando).
  -->

  <div class="hypnosis">
    <video
      class="hypnosis__rickroll"
      id="hypnosisRickroll"
      src={withBase('video/Rick_Astley_Never_Gonna_Give_You_Up.mp4')}
      autoplay
      muted
      loop
      playsinline
      aria-label="Vídeo de abertura com legenda e descrição do efeito visual"
    >
      <track
        kind="captions"
        srclang="pt"
        label="Português"
        default
        src="data:text/vtt;charset=utf-8,%23%20WebVTT%0A%0A00:00:00.000%20--%3E%2000:00:06.000%0A%3C%20v%20Voice%3E%20Hipnose%20em%20modo%20normal.%0A"
      />
      <track
        kind="descriptions"
        srclang="pt"
        label="Descrição"
        src="data:text/vtt;charset=utf-8,%23%20WebVTT%0A%0A00:00:00.000%20--%3E%2000:00:06.000%0A%20%20Uma%20transmiss%C3%A3o%20visual%20de%20efeito%20hipn%C3%B3tico%20com%20uma%20bola%20e%20flash%20de%20imagem.%0A"
      />
    </video>

    <div class="hypnosis__stage">
      <img class="hypnosis__ball" id="hypnosisBall" src={withBase('img/ball.png')} alt="" draggable="false">

      <div class="hypnosis__flash" id="hypnosisFlash">
        <img class="hypnosis__flash-image" id="hypnosisFlashImage" src={withBase('img/jequiti.webp')} alt="">
      </div>
    </div>

    <div class="hypnosis__overlay" id="hypnosisOverlay"></div>

    <div class="hypnosis__angelical-overlay" id="hypnosisAngelicalOverlay"></div>

    <div class="hypnosis__blackout" id="hypnosisBlackout"></div>

    <video class="hypnosis__easter-egg" id="hypnosisEasterEgg" playsinline></video>
    <div class="hypnosis__easter-egg-filter" id="hypnosisEasterEggFilter"></div>

    <canvas class="hypnosis__idle" id="hypnosisIdle" aria-label="Modo inativo: animação do logo DVD quicando pelos cantos"></canvas>
  </div>

  <SecretTerminal />

  <audio id="hypnosisAudio" src={withBase('audio/siren-head-sounds-new.mp3')} loop preload="auto"></audio>
  <audio id="hypnosisAngelicalAudio" src={withBase('audio/angelical.mp3')} loop preload="auto"></audio>

  <script src="../scripts/main.ts"></script>
</body>
</html>
